---
import { Image } from "astro:assets";
import groupPhoto from "../assets/images/group.jpg";
import { getDictionary } from "../i18n";

const t = getDictionary(Astro.currentLocale);
---

<section class="about" id="about">
	<div class="about__container">
		<div class="about__dec about__dec1 reveal-fade" data-revealed="false"></div>
		<div class="about__dec about__dec2 reveal-fade" data-revealed="false"></div>
		<div class="about__dec about__dec3 reveal-fade" data-revealed="false"></div>

		<div class="about__head reveal-group" data-revealed="false">
			<span class="pill">{t.about.pill}</span>
			<h2 class="about__title" set:html={t.about.title} />
			<p class="about__lead">{t.about.lead}</p>
		</div>

		<ul class="stats">
			{
				t.about.stats.map((stat) => (
					<li class="stat reveal" data-revealed="false">
						<span class="stat__rule" />
						<span class="stat__value">{stat.value}</span>
						<span class="stat__label">{stat.label}</span>
					</li>
				))
			}
		</ul>

		<figure class="about__photo reveal-zoom" data-revealed="false">
			<Image
				src={groupPhoto}
				alt={t.about.photoAlt}
				widths={[800, 1500]}
				sizes="(max-width: 1153px) 100vw, 1153px"
			/>
		</figure>
	</div>
</section>
