---
import { getDictionary } from "../i18n";
import { LINKS } from "../utils/constants";

const t = getDictionary(Astro.currentLocale);
---

<section class="waitlist" id="waitlist">
	<div class="container waitlist__inner reveal-group" data-revealed="false">
		<span class="pill">{t.about.pill}</span>
		<h2 class="waitlist__title" set:html={t.waitlist.title} />
		<p class="waitlist__lead">{t.waitlist.lead}</p>

		<div class="waitlist__links">
			<a href={LINKS.candidate} target="_blank" rel="noopener noreferrer" class="waitlist__link">
				{t.actions.join}
			</a>
			<a
				target="_blank"
				href={LINKS.employer}
				rel="noopener noreferrer"
				class="waitlist__link waitlist__link--second">{t.actions.forEmployers}</a
			>
		</div>
	</div>
</section>
